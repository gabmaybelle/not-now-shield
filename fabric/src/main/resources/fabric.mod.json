{
	"schemaVersion": 1,
	"id": "shieldstrip",
	"version": "${version}",
	"name": "Not Now, Shield",
	"description": "Axes strip, scrape and unwax even with a shield in your off-hand. When there's nothing to change, the shield raises as normal. Your shield is also drawn lower, so it covers less of your view.",
	"authors": [
		"Gabby"
	],
	"contact": {
		"homepage": "https://github.com/gabmaybelle/not-now-shield",
		"sources": "https://github.com/gabmaybelle/not-now-shield",
		"issues": "https://github.com/gabmaybelle/not-now-shield/issues"
	},
	"license": "MIT",
	"icon": "assets/shieldstrip/icon.png",
	"environment": "*",
	"mixins": [
		"shieldstrip.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "1.21.1",
		"java": ">=21"
	}
}
